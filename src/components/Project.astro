---
import { cn } from "../utils/utils";
import ProjectBannar from "./project/ProjectBanner.astro"
import ProjectData from "./project/ProjectData.astro";

interface Props {
  project: Project
  linkName: string
  isMirroredToRight?: boolean
  lang?: "ar" | "en"
}

const {isMirroredToRight,linkName , project, lang = "ar"} = Astro.props;
const {title, shortDescription, metadata, bannar, technologies, url} = project;
// left-[41.5%] top-[33%]
---

<div class={cn("flex flex-col items-center justify-center gap-10 mb-10 lg:mb-20 opacity-0 project", isMirroredToRight ? "md:flex-row-reverse translate-x-[-50px]" : "md:flex-row translate-x-[50px] right")}>
  <ProjectData title={title} shortDescription={shortDescription} technologies={technologies}/>
  <ProjectBannar metadata={metadata} bannar={bannar} linkName={linkName} url={url} lang={lang}/ >
</div>

