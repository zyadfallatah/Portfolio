---
---

<div id="onboarding">
  <div id="onboarding-card">
    <img src="/assets/logo.svg" alt="logo" class="logo" />

    <section class="onboarding-section">
      <p class="section-label" id="lang-label">اختر لغتك &nbsp;/&nbsp; Choose your language</p>
      <div class="choices">
        <button class="choice-card" data-lang="ar">
          <span class="choice-icon">🇸🇦</span>
          <span class="choice-text">العربية</span>
        </button>
        <button class="choice-card" data-lang="en">
          <span class="choice-icon">🌐</span>
          <span class="choice-text">English</span>
        </button>
      </div>
    </section>

    <section class="onboarding-section">
      <p class="section-label">المظهر &nbsp;/&nbsp; Theme</p>
      <div class="choices">
        <button class="choice-card" data-theme="light">
          <span class="choice-icon">☀️</span>
          <span class="choice-text">Light</span>
        </button>
        <button class="choice-card" data-theme="dark">
          <span class="choice-icon">🌙</span>
          <span class="choice-text">Dark</span>
        </button>
      </div>
    </section>

    <a id="start-link" href="/" aria-disabled="true">ابدأ &nbsp;/&nbsp; Start</a>
  </div>
</div>

<style>
  #onboarding {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: #f4f5f7;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s ease;
    font-family: var(--font-sans, "Changa"), sans-serif;
  }

  :global(.dark) #onboarding {
    background-color: #0e151f;
  }

  #onboarding-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem 2rem;
    width: 100%;
    max-width: 480px;
  }

  .logo {
    max-width: 160px;
    opacity: 0.9;
  }

  section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .section-label {
    font-size: 0.95rem;
    color: #5a6a7a;
    letter-spacing: 0.02em;
  }

  :global(.dark) .section-label {
    color: #9da7b3;
  }

  .choices {
    display: flex;
    gap: 1rem;
    width: 100%;
    justify-content: center;
  }

  .choice-card {
    flex: 1;
    max-width: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem 0.75rem;
    border-radius: 0.5rem;
    border: 2px solid #c7cdd5;
    background: linear-gradient(180deg, #f8f9fa 0%, #eceef0 100%);
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
    font-family: inherit;
  }

  :global(.dark) .choice-card {
    border-color: #3a4655;
    background: linear-gradient(180deg, #1a2535 0%, #141e2c 100%);
  }

  .choice-card:hover {
    transform: translateY(-2px);
    border-color: #9da7b3;
  }

  :global(.dark) .choice-card:hover {
    border-color: #5a6a7a;
  }

  .choice-card.selected {
    border-color: #3d9e7a;
    background: linear-gradient(180deg, #e8f7f1 0%, #d4f0e6 100%);
  }

  :global(.dark) .choice-card.selected {
    border-color: #3d9e7a;
    background: linear-gradient(180deg, #0d2a1f 0%, #0a2018 100%);
  }

  .choice-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .choice-text {
    font-size: 1rem;
    font-weight: 500;
    color: #333c47;
  }

  :global(.dark) .choice-text {
    color: #d0d8e4;
  }

  .choice-card.selected .choice-text {
    color: #2b7a5c;
  }

  :global(.dark) .choice-card.selected .choice-text {
    color: #5ccba0;
  }

  #start-link {
    margin-top: 0.5rem;
    padding: 0.85rem 3rem;
    border-radius: 0.5rem;
    border: 1px solid #2b7a5c;
    background: linear-gradient(180deg, #6ecda4 0%, #3d9e7a 100%);
    color: #fff;
    font-family: inherit;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(61, 158, 122, 0.35);
    transition: opacity 0.2s ease, transform 0.15s ease;
    text-decoration: none;
    display: inline-block;
  }

  #start-link[aria-disabled="true"] {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
    pointer-events: none;
  }

  #start-link[aria-disabled="false"]:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }
</style>

<script>
  import { animate, stagger } from "motion";

  const onboardingCard = document.getElementById("onboarding-card") as HTMLDivElement;
  const logo = document.querySelector(".logo") as HTMLImageElement;
  const sections = document.querySelectorAll<HTMLElement>(".onboarding-section");
  const startLink  = document.getElementById("start-link") as HTMLAnchorElement;
  const langCards  = document.querySelectorAll<HTMLButtonElement>("[data-lang]");
  const themeCards = document.querySelectorAll<HTMLButtonElement>("[data-theme]");
  const html       = document.documentElement;
  const currentUrl = new URL(window.location.href);

  let selectedLang: string | null = null;
  let selectedTheme: string | null = null;
  let nextPath = sanitizePath(currentUrl.searchParams.get("next"));

  function sanitizePath(candidate: string | null) {
    if (!candidate) return "/";
    if (!candidate.startsWith("/")) return "/";
    if (candidate.startsWith("//")) return "/";
    return candidate;
  }

  function toLangPath(path: string, lang: string) {
    if (lang === "en") {
      if (path === "/en") return "/en/";
      return path.startsWith("/en/") ? path : `/en${path}`;
    }
    if (path === "/en" || path === "/en/") return "/";
    if (!path.startsWith("/en/")) return path;
    const withoutPrefix = path.slice(3);
    return withoutPrefix === "" ? "/" : withoutPrefix;
  }

  // ── 1. Language card selection ───────────────────────────────────────
  langCards.forEach((card) => {
    card.addEventListener("click", () => {
      animate(card, { scale: [1, 1.03, 1] }, { duration: 0.25 });
      langCards.forEach((c) => c.classList.remove("selected"));
      card.classList.add("selected");
      selectedLang = card.dataset.lang!;
      updateStartLink();
    });
  });

  // ── 2. Theme card selection + live preview ───────────────────────────
  themeCards.forEach((card) => {
    card.addEventListener("click", () => {
      animate(card, { scale: [1, 1.03, 1] }, { duration: 0.25 });
      themeCards.forEach((c) => c.classList.remove("selected"));
      card.classList.add("selected");
      selectedTheme = card.dataset.theme!;
      // Live preview
      if (selectedTheme === "dark") {
        html.classList.add("dark");
      } else {
        html.classList.remove("dark");
      }
      updateStartLink();
    });
  });

  // ── 3. Enable Start link when both are chosen ────────────────────────
  function updateStartLink() {
    const hasSelections = Boolean(selectedLang && selectedTheme);
    startLink.setAttribute("aria-disabled", hasSelections ? "false" : "true");
    if (!hasSelections || !selectedLang) {
      startLink.href = "#";
      return;
    }
    startLink.href = toLangPath(nextPath, selectedLang);
  }

  // ── 4. Start link ────────────────────────────────────────────────────
  startLink.addEventListener("click", () => {
    if (!selectedLang || !selectedTheme) return;

    if (selectedTheme === "dark") {
      localStorage.setItem("theme", "dark");
    } else {
      localStorage.removeItem("theme");
    }
    localStorage.setItem("lang", selectedLang);
  });

  // ── 5. Entrance animations ───────────────────────────────────────────
  animate(onboardingCard, { opacity: [0, 1], y: [20, 0] }, { duration: 0.45 });
  animate(logo, { opacity: [0, 0.9], scale: [0.96, 1] }, { duration: 0.45, delay: 0.1 });
  animate(sections, { opacity: [0, 1], y: [10, 0] }, { duration: 0.35, delay: stagger(0.12, { startDelay: 0.18 }) });
  animate(startLink, { opacity: [0, 1], y: [8, 0] }, { duration: 0.35, delay: 0.45 });

  updateStartLink();
</script>
