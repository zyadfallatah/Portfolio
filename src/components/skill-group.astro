---
import Button from './Button.astro';

interface Props {
  text: string
  skillSets: {name: string, icon?: string}[]
}

const {text, skillSets} = Astro.props;
---

<div class="mt-8 md:mt-12">
  <div class="relative">
    <h3 class="absolute text-light text-xl md:text-3xl font-bold right-1/4 top-1/2 -translate-y-1/3">{text}</h3>
    <img src="/assets/skill-group.svg" alt="skill group" class="max-sm:max-w-[250px]">
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 gap-y-4 mt-5">
  {
    skillSets.map((skill) => (
      <Button text={skill.name} variant='light' icon={skill.icon &&  skill.icon} className='p-2 flex-1'/>
    ))
  }

  </div>
</div>