---
import { cn } from '../utils/utils';
import Button from './Button.astro';

interface Props {
  text: string
  skillSets: {name: string, icon?: string}[]
  lang: string
}

const {text, skillSets, lang} = Astro.props;
const defaultVisibleCount = 5;
const visibleSkills = skillSets.slice(0, defaultVisibleCount);
const hiddenSkills = skillSets.slice(defaultVisibleCount);
const remainingCount = hiddenSkills.length;
const remainingLabel = `+${Math.min(remainingCount, 10)}`;
---

<div class="max-lg:mt-4 skill-group-block">
  <div class="relative">
    <h3 class={cn("absolute text-light text-xl md:text-3xl font-bold z-20", lang === "ar" ? "right-1/4 top-1/2 -translate-y-1/3" : "left-1/5 top-1/2 -translate-y-1/3")}>{text}</h3>
    <img src="/assets/skill-group.svg" alt="skill group" class={cn("-z-10 max-sm:max-w-[250px]", lang === "en" && "rotate-y-180")}>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 gap-y-4 mt-5 max-w-[370px]">
    {visibleSkills.map((skill) => (
      <Button text={skill.name} variant='light' icon={skill.icon && skill.icon} className='p-2 flex-1 max-sm:text-sm'/>
    ))}

    {remainingCount > 0 && (
      <div class="extra-skills-wrapper col-span-full overflow-hidden" style="height: 0;">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 gap-y-4 pt-2">
          {hiddenSkills.map((skill) => (
            <Button text={skill.name} variant='light' icon={skill.icon && skill.icon} className='p-2 flex-1 max-sm:text-sm extra-skill'/>
          ))}
        </div>
      </div>
    )}

    {remainingCount > 0 && (
      <button
        type="button"
        class="skills-toggle cursor-pointer size-[44px] rounded-full border border-[rgba(101,112,128,0.6)] bg-linear-180 from-[rgba(120,133,151,0.95)] to-[rgba(86,99,117,0.95)] text-sm font-bold text-light shadow shadow-[rgba(64,73,88,0.5)] transition-opacity duration-300 hover:opacity-90"
        data-collapsed-label={remainingLabel}
        aria-expanded="false"
      >
        {remainingLabel}
      </button>
    )}
  </div>
</div>

<style>
  .extra-skill {
    opacity: 0;
    transform: scale(0.88);
  }
  .extra-skills-wrapper {
    transition: height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>

<script>
  import { animate, stagger } from "motion";

  const groups = document.querySelectorAll<HTMLElement>(".skill-group-block");
  groups.forEach((group) => {
    const toggle = group.querySelector<HTMLButtonElement>(".skills-toggle");
    if (!toggle) return;
    const wrapper = group.querySelector<HTMLElement>(".extra-skills-wrapper");
    const innerGrid = wrapper?.firstElementChild as HTMLElement | null;
    const extraSkills = group.querySelectorAll<HTMLElement>(".extra-skill");
    const collapsedLabel = toggle.dataset.collapsedLabel ?? "+0";
    let expanded = false;
    let busy = false;

    toggle.addEventListener("click", async () => {
      if (busy || !wrapper || !innerGrid) return;
      busy = true;
      expanded = !expanded;
      toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
      toggle.textContent = expanded ? "−" : collapsedLabel;

      if (expanded) {
        wrapper.style.height = innerGrid.scrollHeight + "px";
        await animate(
          extraSkills,
          { opacity: 1, scale: 1 },
          { duration: 0.22, delay: stagger(0.05, { startDelay: 0.12 }) }
        ).finished;
      } else {
        await animate(
          extraSkills,
          { opacity: 0, scale: 0.88 },
          { duration: 0.15 }
        ).finished;
        wrapper.style.height = "0";
      }

      busy = false;
    });
  });
</script>