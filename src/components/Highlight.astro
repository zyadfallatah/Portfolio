---
import { cn } from '../utils/utils'

interface Props {
  title: string,
  contentType: "Default" | "Custom"
  children: any
  variant?: "normal" | "special"
  className?: string
}

const { title, contentType, variant } = Astro.props

const style = variant === "normal" || !variant ? "bg-dark-lighter" : "bg-linear-90 from-primary-darker to-[hsl(0,0%,25%)]"

---

<div class={cn("px-4 py-5 md:p-7 rounded-md mb-8 bg-linear-90", style)}>
  <h3 class="light-text-gradient w-fit font-medium text-2xl md:text-[2rem] mb-2">{title}</h3>
  {contentType == "Default" && (
      <p class="max-w-[600px] text-light text-[.9rem] md:text-xl"><slot /></p>
  )}
  
  {contentType == "Custom" && (
    <div class="max-w-[600px]">
      <slot />
    </div>
  )}

</div>