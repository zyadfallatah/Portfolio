---
import { cn } from '../utils/utils'

interface Props {
  title: string,
  contentType: "Default" | "Custom"
  children: any
  variant?: "normal" | "special"
  className?: string
  limitText?: boolean
  isScrollable?: boolean
}

const { title, contentType, variant, limitText, isScrollable, className } = Astro.props

const style = variant === "normal" || !variant ? "bg-dark-lighter" : "bg-linear-90 from-primary-darker to-[hsl(0,0%,25%)]"
const limit = limitText && "max-w-[600px]"
const scrollLimit = isScrollable && "max-h-[200px] overflow-scroll"
---

<div class={cn("px-4 py-5 md:p-7 rounded-md bg-linear-90`", style, scrollLimit, className)}>
  <h3 class="light-text-gradient w-fit font-medium text-[1rem] sm:text-2xl md:text-[2rem] mb-2">{title}</h3>
  {contentType == "Default" && (
      <p class={cn("text-light text-[.9rem] md:text-xl", limit)}><slot /></p>
  )}
  
  {contentType == "Custom" && (
    <div class={limit ? limit : ""}>
      <slot />
    </div>
  )}

</div>