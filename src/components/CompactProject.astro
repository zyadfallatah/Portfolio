---
interface Props {
  project: Project;
  lang?: "ar" | "en";
}

const { project, lang = "ar" } = Astro.props;
const detailsHref = project.linkName
  ? lang === "en"
    ? `/en/projects/${project.linkName}`
    : `/projects/${project.linkName}`
  : undefined;
const ctaHref = project.compact ? project.url : detailsHref;
const ctaLabel = project.compact
  ? (lang === "en" ? "Visit project" : "زيارة المشروع")
  : (lang === "en" ? "Visit details" : "زيارة التفاصيل");
---

<article class="compact-project opacity-0 rounded-xl border border-[rgba(101,112,128,0.28)] bg-[linear-gradient(180deg,rgba(255,255,255,0.75)_0%,rgba(244,245,247,0.88)_100%)] p-4 shadow-[0_8px_22px_rgba(85,99,117,0.14)] transition-all duration-300 hover:-translate-y-1 hover:border-[rgba(101,112,128,0.52)] hover:shadow-[0_14px_30px_rgba(86,99,117,0.24)] dark:border-[rgba(127,142,163,0.28)] dark:bg-[linear-gradient(180deg,rgba(35,48,65,0.76)_0%,rgba(17,24,35,0.94)_100%)] dark:shadow-[0_10px_26px_rgba(0,0,0,0.4)] dark:hover:border-[rgba(165,178,195,0.42)]">
  <div class="flex items-start justify-between gap-4">
    <h3 class="light-text-gradient text-2xl font-bold">{project.title}</h3>
    {project.metadata?.[0] && (
      <span class="shrink-0 rounded-full bg-[rgba(101,112,128,0.14)] px-3 py-1 text-xs font-semibold text-dark-lighter dark:bg-[rgba(127,142,163,0.2)] dark:text-light">
        {project.metadata[0]}
      </span>
    )}
  </div>

  <p class="mt-3 whitespace-pre-line text-[0.98rem] text-dark-lighter dark:text-light">
    {project.shortDescription}
  </p>

  <ul class="mt-4 flex flex-wrap gap-2">
    {project.technologies.slice(0, 4).map((tech) => (
      <li class="rounded-md border border-[rgba(101,112,128,0.32)] bg-[rgba(255,255,255,0.52)] px-2 py-1 text-xs font-medium text-dark-lighter dark:border-[rgba(127,142,163,0.3)] dark:bg-[rgba(57,67,81,0.6)] dark:text-light">
        {tech.name}
      </li>
    ))}
  </ul>

  <div class="mt-4 flex items-center gap-3">
    {ctaHref && (
      <a href={ctaHref} class="rounded-md border border-[rgba(101,112,128,0.55)] bg-linear-180 from-[rgba(120,133,151,0.95)] to-[rgba(86,99,117,0.95)] px-4 py-2 text-sm font-semibold text-light shadow shadow-[rgba(64,73,88,0.5)] transition-opacity duration-300 hover:opacity-90">
        {ctaLabel}
      </a>
    )}
  </div>
</article>
