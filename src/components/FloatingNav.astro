---
interface Props {
  lang?: "ar" | "en";
}
const { lang = "ar" } = Astro.props;
const isEn = lang === "en";

const sections = isEn
  ? [
      { id: "welcome",    label: "Home",       mobileLabel: "Home"   },
      { id: "projects",   label: "Projects",   mobileLabel: "Work"   },
      { id: "experience", label: "Experience", mobileLabel: "Exp"    },
      { id: "skills",     label: "Skills",     mobileLabel: "Skills" },
      { id: "about",      label: "About",      mobileLabel: "About"  },
    ]
  : [
      { id: "welcome",    label: "مرحباً",  mobileLabel: "مرحباً"  },
      { id: "projects",   label: "مشاريع",  mobileLabel: "مشاريع"  },
      { id: "experience", label: "خبرة",    mobileLabel: "خبرة"    },
      { id: "skills",     label: "مهارات",  mobileLabel: "مهارات"  },
      { id: "about",      label: "عني",     mobileLabel: "عني"     },
    ];
---

<!-- Desktop: vertical right-side nav -->
<nav class="fixed right-6 top-1/3 -translate-y-1/2 z-50 hidden md:flex flex-col gap-5" aria-label="Page sections" dir="ltr">
  {sections.map((section) => (
    <a
      href={`#${section.id}`}
      data-nav-id={section.id}
      class="nav-item group flex items-center gap-3 justify-end"
      aria-label={section.label}
    >
      <span class="nav-label text-sm font-medium px-2.5 py-1 rounded bg-[rgba(244,245,247,0.92)] dark:bg-[rgba(35,48,65,0.92)] text-dark-lighter dark:text-light border border-[rgba(101,112,128,0.28)] dark:border-[rgba(127,142,163,0.28)] whitespace-nowrap shadow-sm backdrop-blur-sm transition-colors duration-300">
        {section.label}
      </span>
      <span class="nav-dot w-3 h-3 rounded-full border-2 border-[rgba(101,112,128,0.45)] bg-transparent transition-all duration-300 group-hover:border-primary group-hover:scale-110 shrink-0"></span>
    </a>
  ))}
</nav>

<!-- Mobile: bottom floating pill nav -->
<nav class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 flex md:hidden items-center gap-0.5 p-1 rounded-full bg-[rgba(244,245,247,0.92)] dark:bg-[rgba(35,48,65,0.92)] border border-[rgba(101,112,128,0.28)] dark:border-[rgba(127,142,163,0.28)] shadow-[0_4px_16px_rgba(85,99,117,0.18)] backdrop-blur-sm" aria-label="Page sections">
  {sections.map((section) => (
    <a
      href={`#${section.id}`}
      data-nav-id={section.id}
      class="nav-item-mobile px-2.5 py-1 rounded-full text-xs font-medium text-primary dark:text-primary-lighter whitespace-nowrap transition-all duration-300"
      aria-label={section.label}
    >
      {section.mobileLabel}
    </a>
  ))}
</nav>

<style>
  .nav-item.active .nav-dot {
    background-color: var(--color-primary-darker);
    border-color: var(--color-primary-darker);
    transform: scale(1.25);
  }
  .nav-item.active .nav-label {
    color: var(--color-dark-lighter);
    font-weight: 700;
  }
  :global(.dark) .nav-item.active .nav-label {
    color: var(--color-light);
  }
  .nav-item-mobile.active {
    background-color: var(--color-primary-darker);
    color: var(--color-light);
    font-weight: 700;
  }
</style>

<script>
  const navItems = document.querySelectorAll<HTMLAnchorElement>("[data-nav-id]");
  const sectionIds = [...new Set(Array.from(navItems).map((el) => el.dataset.navId!))];
  function setActive(id: string) {
    navItems.forEach((item) => {
      item.classList.toggle("active", item.dataset.navId === id);
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target.id);
      });
    },
    { rootMargin: "-35% 0px -35% 0px", threshold: 0 }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  navItems.forEach((item) => {
    item.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById(item.dataset.navId!)?.scrollIntoView({ behavior: "smooth" });
    });
  });
</script>
