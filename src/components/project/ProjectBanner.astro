---
import Button from "../Button.astro";
interface Props extends Pick<Project, "metadata" | "bannar" > {
}

const {bannar, metadata} = Astro.props;
---

<div class="flex flex-col-reverse lg:flex-row justify-between gap-2 lg:w-[420px] bg-linear-90 from-light-lighter to-primary-lighter rounded-md p-2">
  <div class="flex flex-col gap-5 justify-between flex-1 pt-2">
    <div class="space-y-2">
      {metadata.map((data) => (
        <p class="font-light text-light bg-linear-90 from-primary-darker to-[#4d4d4d] p-1 text-[.75rem] rounded-md w-full">{data}</p>
      ))}
    </div>

    <div class="flex gap-2 pb-2">
      <Button text="معاينة" variant="primary" className=" flex-1 p-1.5"/>
      <Button text="الكود" variant="light" className="flex-1 p-1.5"/>
    </div>
  </div>
  <img src={bannar} alt="mulabbi banner" class="w-full lg:max-w-[260px]">
</div>