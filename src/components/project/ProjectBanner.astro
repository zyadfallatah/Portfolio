---
import Button from "../Button.astro";
interface Props extends Pick<Project, "metadata" | "bannar" | "linkName" | "url" > {
  lang?: "ar" | "en"
}

const {bannar, metadata, linkName, url, lang = "ar"} = Astro.props;
---

<div class="relative flex flex-col-reverse lg:flex-row justify-between gap-2 lg:w-[420px] bg-linear-90 from-dark-lighter dark:from-light-lighter to-primary-darker dark:to-primary-lighter rounded-md p-2">
  <div class="flex flex-col gap-5 justify-between flex-1 pt-2">
    <div class="space-y-2">
      {metadata.map((data) => (
        <p class="font-light text-light bg-linear-90 from-primary-darker to-[#4d4d4d] p-1 text-[.75rem] rounded-md w-full">{data}</p>
      ))}
    </div>

    <div class="flex gap-2 pb-2">
      <Button text={lang === 'en' ? 'Preview' : 'معاينة'} variant="accent" className=" flex-1 p-1.5" href={url}/>
      <Button text={lang === 'en' ? 'Code' : 'الكود'} variant="light" className="flex-1 p-1.5" href={`https://github.com/zyadfallatah/${linkName}`}/>
    </div>
  </div>
    <div class="absolute -top-4 -right-4">
      <a href={`projects/${linkName}`} class="relative block">
        <img src="/assets/hexagon.svg" alt="hexagon icon" class="max-w-8" >
        <img src="/assets/external-link-alt.svg" alt="" class="absolute left-[56%] top-[52%] -translate-1/2 max-w-4">
      </a>
    </div>
    <img src={bannar} alt="mulabbi banner" class="w-full lg:max-w-[260px]">
</div>