---
import Button from "../Button.astro";
interface Props extends Pick<Project, "metadata" | "bannar" | "linkName" | "url" > {
}

const {bannar, metadata, linkName, url} = Astro.props;
---

<div class="flex flex-col-reverse lg:flex-row justify-between gap-2 lg:w-[420px] bg-linear-90 from-light-lighter to-primary-lighter rounded-md p-2">
  <div class="flex flex-col gap-5 justify-between flex-1 pt-2">
    <div class="space-y-2">
      {metadata.map((data) => (
        <p class="font-light text-light bg-linear-90 from-primary-darker to-[#4d4d4d] p-1 text-[.75rem] rounded-md w-full">{data}</p>
      ))}
    </div>

    <div class="flex gap-2 pb-2">
      <Button text="معاينة" variant="primary" className=" flex-1 p-1.5" href={url}/>
      <Button text="الكود" variant="light" className="flex-1 p-1.5" href={`https://github.com/zyadfallatah/${linkName}`}/>
    </div>
  </div>
  <div class="relative">
    <div class="absolute -top-3 -right-2 lg:hidden">
      <a href={`/projects/${linkName}`} class="relative">
        <img src="/assets/hexagon.svg" alt="hexagon icon" class="max-w-8" >
        <img src="/assets/external-link-alt.svg" alt="hwllo" class="absolute left-[30%] top-[33%] max-w-4">
      </a>
    </div>
    <img src={bannar} alt="mulabbi banner" class="w-full lg:max-w-[260px]">
  </div>
</div>