---
import { cn } from '../../utils/utils';

  interface Props extends Pick<Project, "imagesUrl"> {
    lang?: string;
  }

  const { imagesUrl, lang } = Astro.props
  const isEn = lang === "en"
---

<div class="flex-1">
  <h2 class="light-text-gradient text-4xl p-1 w-fit mb-4">{isEn ? "Images" : "صور"}</h2>
  <div class="relative min-h-[428px] max-w-[250px] lg:max-w-[400px] overflow-x-hidden mx-auto lg:mx-0" id="images">
    {imagesUrl?.map((image, index) => {
      if (index === 0) return <img src={image.url} alt={image.name} class="absolute right-[100%] top-1/2 -translate-y-1/2 max-w-[135px] z-10 duration-500" data-active />
      if (index === 1) return <img src={image.url} alt={image.name} class="absolute right-[50%] top-1/2 -translate-y-1/2 max-w-[135px] duration-500" />
      return <img src={image.url} alt={image.name} class="absolute right-[100%] top-1/2 -translate-y-1/2 max-w-[135px] duration-500" />
    })}
  </div>
  <div class={cn("flex justify-center gap-8 w-full lg:mt-10", isEn && "flex-row-reverse")}>
    <p class="flex items-center text-dark bg-linear-[50deg] from-light to-primary-lighter text-2xl px-4 rounded-md"> <span id="current-image" class="px-1">1</span>  / {imagesUrl?.length ?? 0}</p>
    <img data-arrow="next" data-arrow src="/assets/back-arrow.svg" alt="arrow" class="bg-linear-90 from-light to-[#9DA7B3] p-2 rounded-full cursor-pointer">
  </div>
</div>

<style>
  [data-active] {
    right: 0;
    max-width: 180px;
  }
  @media (min-width: 1024px) {
    [data-active] {
      max-width: 230px;
    }

  }
</style>

<script>
  const images = document.querySelector("#images") as HTMLDivElement
  const currentImage = document.getElementById("current-image") as HTMLSpanElement;
  document.querySelectorAll('[data-arrow]').forEach((arrow) => {
    arrow.addEventListener("click" ,() => {
      const offset = (arrow as HTMLElement).dataset.arrow === "next" ? 1 : -1
      const currentActiveImage = document.querySelector("[data-active]") as HTMLImageElement
      let newIndex = [...images.children].indexOf(currentActiveImage) + offset;

      if (newIndex < 0) newIndex = images.children.length - 1;
      if (newIndex > images.children.length - 1) newIndex = 0;
      
      let nextIndex = newIndex + offset;
      if (nextIndex < 0) nextIndex = images.children.length - 1;
      if (nextIndex > images.children.length - 1) nextIndex = 0;


      (images.children[newIndex] as HTMLImageElement).dataset.active = "true";
      (images.children[newIndex] as HTMLImageElement).classList.add("z-10");
      (images.children[Math.abs(nextIndex) % images.children.length] as HTMLImageElement).classList.remove("right-[100%]");
      (images.children[Math.abs(nextIndex) % images.children.length] as HTMLImageElement).classList.add("right-[50%]");
      currentActiveImage.classList.remove("z-10")
      currentActiveImage.classList.add("right-[100%]")

      currentImage.innerHTML = (newIndex + 1).toString();
      delete currentActiveImage!.dataset.active
    })
  })
  
</script>