---
import Highlight from "../Highlight.astro";
import Markdown from "../markdown.md";
import Prose from "../Prose.astro";

type Props = {project:Project};
const {project} = Astro.props

const { longDescription, content } = project;
---

<div class="w-full">
  <Highlight title="وصف دقيق للمشروع" contentType="Default" variant="special">
    <p class="text-light font-light text-[.65rem] md:text-[1rem] lg:text-xl">
      {longDescription  }
    </p>
  </Highlight>
  <Highlight title="تجاربي الشخصية مع المشروع" contentType="Custom" isScrollable={true} >
    <Prose>
      <Markdown />
    </Prose>
  </Highlight>
</div>