---
import Button from "../Button.astro"
import Project from "../Project.astro"
---

<div class="landing-reverse justify-start">
  <h2 class="light-text-gradient text-6xl p-5 font-bold md:text-7xl my-10">أعمالي</h2>
  <main class="relative space-y-20 lg:space-y-[12rem]">
    <span class="hidden lg:block absolute z-0 left-[51.5%] w-2 min-h-[calc(100svh-225px)] bg-linear-180 from-light-lighter to-[#9DA7B3] rounded-md"></span>
    
    <Project project={{title: "ملبي", shortDescription: `تطبيق يرشد الحاج أو المعتمر\n
لأداء مناسكه خطوة بخطوة`, technologies: [{name: "flutter", icon: "/assets/flutter.svg"}, {name: "supabase", icon: "/assets/Supabase.svg"}], metadata: ["المنصة: تطبيق جوال "], bannar: "/images/mulabbi-banner.svg"}} />
    
    <Project isMirroredToRight={true} project={{title: "DevFlow", shortDescription: `موقع تواصل و أسئلة 
بين المطورين`, technologies: [{name: "React", icon: "/assets/react.svg"}, {name: "Tailwind", icon: "/assets/tailwindcss.svg"},
{name: "MongoDB", icon: "/assets/Mongodb.svg"}
], metadata: ["المنصة: تطبيق ويب "], bannar: "/images/devflow-banner.svg"}} />

<Button text="قريباً" variant="primary" className="relative py-3 px-8 mx-auto z-10 block translate-3.5"/>
</main>

</div>