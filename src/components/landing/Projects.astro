---
import { getCollection } from "astro:content"
import Button from "../Button.astro"
import Project from "../Project.astro"

const projects = await getCollection('projects').then((collection) => {
  return collection.reverse();
});
---

<div class="landing-reverse justify-start" id="projects">
  <h2 class="light-text-gradient text-6xl p-5 font-bold md:text-7xl my-10">أعمالي</h2>
  <main class="relative space-y-20 lg:space-y-[12rem]">
    <span class="hidden lg:block absolute z-0 left-[51.5%] w-2 bg-linear-180 from-light-lighter to-[#9DA7B3] rounded-md project-line"></span>
    {projects.map(({data: {linkName, ...rest}}, index) => (
      <Project isMirroredToRight={index % 2 === 1} linkName={linkName ?? rest.title} project={rest} />
    ))}

  <Button text="المزيد" variant="disabled" href="/projects" className="relative py-3 px-8 mx-auto z-10 block lg:translate-x-4.5"/>
</main>

</div>

<script>
  import { animate, inView, stagger } from "motion";

  const projects = document.querySelectorAll(".project");
  const line = document.querySelector(".project-line")!;

  inView(projects, (project) => {
    const isMirroredToRight = project.classList.contains("right")
    animate(project, {opacity: 1, x: isMirroredToRight ? -50 : 50}, {duration: .6, delay: stagger(2, {startDelay: .2})})

    return () => animate(project, {opacity: .9, x: isMirroredToRight ? -55 : 55});
  })
  inView(line, (project) => {
    animate(project, {opacity: 1, height: 600}, {duration: 1.2, delay: .8})

    return () => animate(project, {opacity: .7});
  })
</script>