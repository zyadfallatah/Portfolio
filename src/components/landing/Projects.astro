---
import {projects} from "../../constants/index"
import Button from "../Button.astro"
import Project from "../Project.astro"
---

<div class="landing-reverse justify-start" id="projects">
  <h2 class="light-text-gradient text-6xl p-5 font-bold md:text-7xl my-10">أعمالي</h2>
  <main class="relative space-y-20 lg:space-y-[12rem]">
    <span class="hidden lg:block absolute z-0 left-[51.5%] w-2 min-h-[600px] bg-linear-180 from-light-lighter to-[#9DA7B3] rounded-md"></span>
    {projects.map(({linkName, ...rest}, index) => (
      <Project isMirroredToRight={index % 2 === 1} linkName={linkName ?? rest.title} project={rest} />
    ))}

<Button text="قريباً" variant="primary" className="relative py-3 px-8 mx-auto z-10 block lg:translate-x-4.5"/>
</main>

</div>