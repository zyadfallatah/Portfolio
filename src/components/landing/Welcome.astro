---
import { en } from "../../i18n/en";
import Button from "../Button.astro";
import SocialLink from "../SocialLink.astro";

interface Props {
  lang?: "ar" | "en"
}

const { lang = "ar" } = Astro.props;
const t = lang === 'en' ? en : null;
---

<div class="landing min-h-svh" id="welcome">
	<span class="absolute top-10 right-16 z-10 cursor-pointer" id="theme">
		<img src="/assets/sun-logo.svg" alt="Dark mode" class="hidden dark:block max-w-10 lg:max-w-14">
		<img src="/assets/moon-logo.svg" alt="Light mode" class="dark:hidden max-w-10 lg:max-w-14">
	</span>
	<a href={lang === 'ar' ? '/en/' : '/'} onclick={`localStorage.setItem('lang', '${lang === 'ar' ? 'en' : 'ar'}')`} class="absolute top-10 left-16 z-10 text-dark-lighter dark:text-light font-semibold text-xl">
		{lang === 'ar' ? 'EN' : 'AR'}
	</a>
	<img src="/assets/logo.svg" alt="logo" class="max-w-[150px] lg:max-w-[230px] mb-10 opacity-0 logo">
			<h1 class="font-normal max-sm:text-5xl text-6xl md:text-7xl text-dark-lighter dark:text-light md:mt-10 translate-x-[-100px] opacity-0 heading">
				{t ? t.greeting : 'أنا'}
				<span class="light-text-gradient font-bold">{t ? t.name : 'زياد'}</span>
			</h1>
			<h2 class="text-3xl md:text-[44px] text-center text-dark-lighter dark:text-light mt-5 heading translate-x-[-100px] opacity-0">{t ? t.role : 'مطور برمجيات و أنظمة'}</h2>

			<ul class="w-full mt-8 md:mt-14 flex justify-center gap-16 md:mb-10 md:justify-between max-w-[450px]">
				<li class="welcome-link opacity-0 translate-y-[-500px]">
					<SocialLink href='https://www.linkedin.com/in/ziyad-fallatah/' alt='x logo' imagePath='/assets/linkedin.svg'/>
				</li>
				<li class="welcome-link opacity-0  translate-y-[-500px]">
					<SocialLink href='https://x.com/zyad_fallatah' alt='x logo' imagePath='/assets/x.svg'/>
				</li>
				<li class="welcome-link opacity-0  translate-y-[-500px]">
					<SocialLink href='https://github.com/zyadfallatah' alt='x logo' imagePath='/assets/github.svg'/>
				</li>
			</ul>

			<div class="mt-12 flex w-full max-w-[500px] flex-col gap-5 sm:flex-row  justify-center items-center welcome-buttons opacity-0 translate-x-[-100px]">
				<Button variant={"accent"} text={t ? t.ctaProjects : 'شاهد أعمالي'} href='#projects' languageLink={lang} className='w-full p-4 text-2xl max-w-[240px] md:text-[2rem] md:min-h-[90px]' />
				<Button variant={"outline"} text={t ? t.ctaAbout : 'عني'} href='#about' languageLink={lang} className='w-full p-4 text-2xl max-w-[240px] md:text-[2rem] md:min-h-[90px]' />
			</div>

</div>

<script>
	// Theme
	const theme = document.getElementById("theme")!;
	theme.addEventListener("click", () => {
		document.querySelector("html")!.classList.toggle("dark");
		!localStorage.getItem("theme") ? localStorage.setItem("theme", "dark") : localStorage.removeItem("theme");
	})

	// Animations
	import { animate, stagger } from "motion";

	const heading = document.querySelectorAll(".heading")!;
	const logo = document.querySelector(".logo")!
	const links = document.querySelectorAll(".welcome-link")!;
	const buttons = document.querySelector(".welcome-buttons")!;

	animate(heading, {x: 100, opacity: 1}, {duration: .7, delay: stagger(.15)})
	animate(logo, {opacity: 1}, {duration: .4, delay: .5})
	animate(links, {y: [550, 480, 500], opacity: [0, .5, 1]}, {duration: .7, delay: stagger(.15, {startDelay: .3})})
	animate(buttons, {x: [80, 110, 100], opacity: [0, .1 ,.7, 1]}, {duration: .7, delay: .8})

</script>
