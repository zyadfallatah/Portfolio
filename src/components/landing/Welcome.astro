---
import Button from "../Button.astro";
import SocialLink from "../SocialLink.astro";
---

<div class="landing min-h-svh">
	<img src="/assets/logo.svg" alt="logo" class="max-w-[230px] mb-10 opacity-0 logo">
			<h1 class="font-normal text-6xl md:text-7xl text-light md:mt-10 translate-x-[-100px] opacity-0 heading">
				أنا
				<span class="light-text-gradient font-bold">زياد</span>
			</h1>
			<h2 class="text-3xl md:text-[44px] text-center text-light mt-5 heading translate-x-[-100px] opacity-0">مطور مواقع و تطبيقات</h2>
	
			<ul class="w-full mt-8 md:mt-14 flex justify-center gap-16 md:mb-10 md:justify-between max-w-[450px]">
				<li class="welcome-link opacity-0 translate-y-[-500px]">
					<SocialLink href='https://www.linkedin.com/in/ziyad-fallatah/' alt='x logo' imagePath='/assets/linkedin.svg'/>
				</li>
				<li class="welcome-link opacity-0  translate-y-[-500px]">
					<SocialLink href='https://x.com/zyad_fallatah' alt='x logo' imagePath='/assets/x.svg'/>
				</li>
				<li class="welcome-link opacity-0  translate-y-[-500px]">
					<SocialLink href='https://github.com/zyadfallatah' alt='x logo' imagePath='/assets/github.svg'/>
				</li>
			</ul>
	
			<div class="mt-12 flex w-full max-w-[500px] flex-col gap-5 sm:flex-row  justify-center items-center welcome-buttons opacity-0 translate-x-[-100px]">
				<Button variant={"primary"} text="شاهد أعمالي" href='#projects' languageLink='ar' className='w-full p-4 text-2xl max-w-[240px] md:text-[2rem] md:min-h-[90px]' />
				<Button variant={"outline"} text="عني" href='#about' languageLink='ar' className='w-full p-4 text-2xl max-w-[240px] md:text-[2rem] md:min-h-[90px]' />
			</div>

</div>

<script>
import { animate, stagger } from "motion";

	const heading = document.querySelectorAll(".heading")!;
	const logo = document.querySelector(".logo")!
	const links = document.querySelectorAll(".welcome-link")!;
	const buttons = document.querySelector(".welcome-buttons")!;

	animate(heading, {x: 100, opacity: 1}, {duration: .7, delay: stagger(.15)})
	animate(logo, {opacity: 1}, {duration: .4, delay: .5})
	animate(links, {y: [550, 480, 500], opacity: [0, .5, 1]}, {duration: .7, delay: stagger(.15, {startDelay: .3})})
	animate(buttons, {x: [80, 110, 100], opacity: [0, .1 ,.7, 1]}, {duration: .7, delay: .8})
	
</script>