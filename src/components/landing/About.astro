---
import Highlight from "../Highlight.astro"
---
<div class="landing justify-start md:items-start" id="about">
  <div class="w-full lg:max-w-[1440px] mx-auto">
    <h2 class="light-text-gradient text-6xl p-5 font-bold md:text-7xl my-10 w-fit">عني</h2>

    <div class="flex">
      <main>
        <Highlight title="نبذة" contentType="Default" variant="special">
          اسمي <span class="light-text-gradient">زياد</span> ، طالب علوم حاسب من جامعة أم القرى
        </Highlight>
        <Highlight title="وصف" contentType="Default">
          أقوم بتصميم و تطوير حلول برمجية تعمل على تحسين حياة الأفراد و المجتمعات، مع التركيز على الجودة العالية و الأداء المتميز، و دائماً ما أتبع أحدث المعايير التقنية و أفضل الممارسات
        </Highlight>
        <Highlight title="الخبرة" contentType="Custom">
          <div class="flex justify-between">
            <div class="flex items-center  gap-2">
              <img src="/assets/d-shape.svg" alt="D Shape">
              <h3 class="light-text-gradient text-xl">جمعية عون التقنية</h3>
            </div>
            <p class="text-xl text-light">4 شهور - تدريب</p>
          </div>
          <span class="flex items-center mr-3 gap-2">
            <img src="/assets/attach-to-d.svg" alt="design">
            <p class="text-light text-[1rem] tracking-normal pt-1.5">وصف للخبرة</p>
          </span>
        </Highlight>
      </main>
      <aside></aside>

    </div>
  </div>
</div>