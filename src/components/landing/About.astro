---
import { en } from "../../i18n/en"
import { cn } from "../../utils/utils"
import Highlight from "../Highlight.astro"
import Footer from "./Footer.astro"

interface Props {
  lang?: "ar" | "en"
}

const { lang = "ar" } = Astro.props;
const t = lang === 'en' ? en : null;
const aboutCardClass = "relative border border-[rgba(101,112,128,0.28)] bg-[linear-gradient(180deg,rgba(255,255,255,0.75)_0%,rgba(244,245,247,0.88)_100%)] shadow-[0_4px_16px_rgba(85,99,117,0.14),inset_0_0_0_1px_rgba(255,255,255,0.5)] backdrop-saturate-115 transition-all duration-300 hover:-translate-y-1 hover:border-[rgba(101,112,128,0.52)] hover:shadow-[0_8px_24px_rgba(85,99,117,0.24)] dark:border-[rgba(127,142,163,0.28)] dark:bg-[linear-gradient(180deg,rgba(35,48,65,0.76)_0%,rgba(17,24,35,0.94)_100%)] dark:shadow-[0_8px_24px_rgba(0,0,0,0.32)] dark:hover:border-[rgba(127,142,163,0.5)] dark:hover:shadow-[0_12px_28px_rgba(0,0,0,0.45)]";
---
<div class=" justify-start md:items-start max-sm:pt-10 pb-10 mb-6 px-8" id="about">
  <div class="w-full lg:max-w-[1440px] mx-auto">
    <h2 class="light-text-gradient max-sm:text-5xl text-6xl p-5 font-bold md:text-7xl my-10 w-fit mx-auto text-center">{t ? t.aboutHeading : 'عني'}</h2>

    <div class="flex flex-col lg:flex-row gap-10 lg:gap-20 items-center justify-center">
      <main class="space-y-5 about-item opacity-0">
        <Highlight title={t ? t.bioTitle : 'نبذة'} contentType="Default" variant="special" limitText={true} className={aboutCardClass}>
          {t ? (
            <>I'm Ziyad. I build <span class="light-text-gradient font-bold">backend systems</span> and think in problems before code.</>
          ) : (
            <>أنا زياد. أبني <span class="light-text-gradient font-bold">أنظمة خلفية</span> وأفكر في المشكلات قبل الكود.</>
          )}
        </Highlight>
        <Highlight title={t ? t.descTitle : 'وصف'} contentType="Default" limitText={true} className={aboutCardClass}>
          {t ? <>I don't start building until I understand why something needs to exist. That's slower, but it's the only way I trust what comes out the other side. Also how I work with people — being someone you can depend on more than being the loudest.</> : <>لا أبدأ في البناء حتى أفهم سبب وجود الشيء. قد يكون أبطأً، لكنه الطريقة الوحيدة التي أثق فيها بالمخرجات النهائية. أفضل أن أكون شخصاً يُعتمد عليه أكثر من أن أكون الأجهر.</>}
        </Highlight>
      </main>
      <aside class="flex flex-col gap-5 w-full max-w-[600px] lg:max-w-[460px] about-item opacity-0">
        <div class={cn("flex items-start gap-4 px-4 py-5 md:p-6 rounded-md", aboutCardClass)}>
          <div class="text-primary dark:text-primary-lighter mt-1 shrink-0">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div>
            <h3 class="light-text-gradient w-fit font-medium text-xl md:text-2xl mb-1">
              {t ? 'Web Applications' : 'تطبيقات الويب'}
            </h3>
            <p class="text-dark-lighter dark:text-light text-sm md:text-base">
              {t ? 'From idea to live product' : 'من الفكرة إلى المنتج الحي'}
            </p>
          </div>
        </div>

        <div class={cn("flex items-start gap-4 px-4 py-5 md:p-6 rounded-md", aboutCardClass)}>
          <div class="text-primary dark:text-primary-lighter mt-1 shrink-0">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="8" rx="2"/>
              <rect x="2" y="14" width="20" height="8" rx="2"/>
              <line x1="6" y1="6" x2="6.01" y2="6"/>
              <line x1="6" y1="18" x2="6.01" y2="18"/>
            </svg>
          </div>
          <div>
            <h3 class="light-text-gradient w-fit font-medium text-xl md:text-2xl mb-1">
              {t ? 'Backend Systems' : 'الأنظمة الخلفية'}
            </h3>
            <p class="text-dark-lighter dark:text-light text-sm md:text-base">
              {t ? 'APIs, databases & infrastructure' : 'APIs، قواعد بيانات، بنية تحتية'}
            </p>
          </div>
        </div>

        <div class={cn("flex items-start gap-4 px-4 py-5 md:p-6 rounded-md", aboutCardClass)}>
          <div class="text-primary dark:text-primary-lighter mt-1 shrink-0">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12.55a11 11 0 0 1 14.08 0"/>
              <path d="M1.42 9a16 16 0 0 1 21.16 0"/>
              <path d="M8.53 16.11a6 6 0 0 1 6.95 0"/>
              <circle cx="12" cy="20" r="1" fill="currentColor" stroke="none"/>
            </svg>
          </div>
          <div>
            <h3 class="light-text-gradient w-fit font-medium text-xl md:text-2xl mb-1">
              {t ? 'Real-time Systems' : 'الأنظمة اللحظية'}
            </h3>
            <p class="text-dark-lighter dark:text-light text-sm md:text-base">
              {t ? 'Sessions, live sync & collaborative features' : 'جلسات، مزامنة فورية، وميزات تعاونية'}
            </p>
          </div>
        </div>

        <div class={cn("flex items-start gap-4 px-4 py-5 md:p-6 rounded-md", aboutCardClass)}>
          <div class="text-primary dark:text-primary-lighter mt-1 shrink-0">
            <svg class="size-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div>
            <h3 class="light-text-gradient w-fit font-medium text-xl md:text-2xl mb-1">
              {t ? 'Education' : 'التعليم'}
            </h3>
            <p class="text-dark-lighter dark:text-light text-sm md:text-base">
              {t ? 'Umm Al-Qura University · CS' : 'جامعة أم القرى · علوم الحاسب'}
            </p>
          </div>
        </div>

      </aside>

    </div>
  </div>
</div>
<Footer />

<script>
  import { animate, inView } from "motion";

  const aboutItems = document.querySelectorAll(".about-item");

  inView(aboutItems, (item) => {
    animate(item, { opacity: 1, y: [20, 0] }, { duration: 0.6 });
    return () => animate(item, { opacity: 0, y: 20 });
  });
</script>
