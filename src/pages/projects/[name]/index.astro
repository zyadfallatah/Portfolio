---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import Button from "../../../components/Button.astro";
import { projects } from "../../../constants";
import ProjectMeta from "../../../components/projectDetail/ProjectMeta.astro";
import type { ACTION_ERROR_CODES } from "astro:actions";
import ProjectHighlight from "../../../components/projectDetail/ProjectHighlight.astro";
export const getStaticPaths = (() => {
  return [
    {params: {name: "mulabbi",}},
    {params: {name: "devflow"}},
  ];
}) satisfies GetStaticPaths;

const {name} = Astro.params
const currentProject = projects.filter((project) => project.linkName === name).at(0);
---
<Layout title={name}>
  <div class="landing min-h-svh items-start justify-start pt-12">
    <div class="flex flex-col items-center sm:items-start max-w-[1440px] w-full px-8 md:px-24 lg:px-32">
      <Button text="العودة" variant="light"  href='/' className="p-3 px-5 mr-auto" icon="/assets/back-arrow.svg"/>
      <h1 class="light-text-gradient text-4xl md:text-6xl font-bold pb-5 pt-2 w-fit mb-5">{currentProject?.title}</h1>
      <div class="flex flex-col lg:flex-row gap-5 lg:gap-16">
        <ProjectMeta project={currentProject!} />
        <ProjectHighlight />
      </div>
    </div>
  </div>
</Layout>