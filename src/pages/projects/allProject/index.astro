---
import AllProject from "../../../components/AllProject.astro";
import Background from "../../../components/Background.astro";
import Button from "../../../components/Button.astro";
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="all-projects">
  <Background variant="subtle">
    <div class="landing min-h-svh items-start justify-start pt-12 pb-14">
      <div class="w-full">
        <div class="max-w-[1200px] mx-auto px-4 md:px-6 mb-5">
          <Button text="العودة" variant="light" href="/#projects" className="max-sm:text-[.75rem] p-2 px-4 md:p-3 md:px-5 mr-auto" icon="/assets/back-arrow.svg" />
        </div>
        <AllProject />
      </div>
    </div>
  </Background>
</Layout>
