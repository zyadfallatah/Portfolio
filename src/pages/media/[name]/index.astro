---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import Button from "../../../components/Button.astro";
import VideoMedia from "../../../components/media/VideoMedia.astro";
import { getCurrentProject } from "../../../utils/utils";
import ImageMedia from "../../../components/media/ImageMedia.astro";
import Background from "../../../components/Background.astro";

export const getStaticPaths = (() => {
  return [
    {params: {name: "mulabbi"}}
  ];
}) satisfies GetStaticPaths;

const { name } = Astro.params
const currentProject = await getCurrentProject(name);
---

<Layout title={name}>
  <Background>
    <div class="landing min-h-svh items-start justify-start pt-12">
      <div class="flex flex-col items-center sm:items-start max-w-[1200px] w-full px-8 lg:px-10 mx-auto">
        <header class="flex justify-between items-center w-full mb-5">
          <h1 class="light-text-gradient text-4xl md:text-6xl font-bold pb-5 pt-2 w-fit">{currentProject?.title}</h1>
          <Button text="العودة" variant="light"  href='/#projects' className=" max-sm:text-[.75rem] p-2 px-4 md:p-3 md:px-5 mr-auto" icon="/assets/back-arrow.svg"/>
        </header>
  
        <div class=" max-w-[600px] mx-auto lg:max-w-none lg:flex gap-14 w-full">
          <VideoMedia videosUrls={currentProject?.videosUrls!}/>
          <ImageMedia imagesUrl={currentProject?.imagesUrl} />
        </div>
      </div>
    </div>
  </Background>
</Layout>